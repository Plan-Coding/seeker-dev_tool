<ui:FluentWindow
    x:Class="Seeker.DevToolbox.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Seeker DevToolbox"
    Width="1100"
    Height="720"
    MinWidth="880"
    MinHeight="560"
    ExtendsContentIntoTitleBar="True"
    FontFamily="Segoe UI Variable Text, Segoe UI"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Grid.Row="0"
            ShowHelp="False"
            Title="Seeker DevToolbox">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/app.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <ui:NavigationView
            x:Name="Nav"
            Grid.Row="1"
            AlwaysShowHeader="False"
            IsBackButtonVisible="Collapsed"
            IsPaneOpen="True"
            IsPaneToggleVisible="False"
            IsTopSeparatorVisible="False"
            OpenPaneLength="264"
            PaneDisplayMode="Left">

            <ui:NavigationView.PaneHeader>
                <ui:TextBox
                    x:Name="SearchBox"
                    Margin="8,4,8,12"
                    KeyDown="OnSearchKeyDown"
                    PlaceholderText="搜索工具(Ctrl+K)"
                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                    <ui:TextBox.Icon>
                        <ui:SymbolIcon Symbol="Search24" />
                    </ui:TextBox.Icon>
                </ui:TextBox>
            </ui:NavigationView.PaneHeader>

            <ui:NavigationView.PaneFooter>
                <StackPanel Margin="8,4,8,12">
                    <ui:Button
                        x:Name="ThemeButton"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Appearance="Transparent"
                        Click="OnThemeClick">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon
                                x:Name="ThemeIcon"
                                VerticalAlignment="Center"
                                FontSize="16"
                                Symbol="WeatherMoon24" />
                            <TextBlock
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Text="{Binding ThemeLabel}" />
                        </StackPanel>
                    </ui:Button>

                    <TextBlock
                        Margin="4,8,0,0"
                        FontSize="11"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        Text="{Binding Version, StringFormat='版本 {0}'}" />
                </StackPanel>
            </ui:NavigationView.PaneFooter>

            <ui:NavigationView.ContentOverlay>
                <ContentControl
                    x:Name="ContentHost"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch" />
            </ui:NavigationView.ContentOverlay>
        </ui:NavigationView>
    </Grid>
</ui:FluentWindow>
