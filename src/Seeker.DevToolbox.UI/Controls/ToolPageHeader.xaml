<UserControl
    x:Class="Seeker.DevToolbox.UI.Controls.ToolPageHeader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock
            FontSize="26"
            FontWeight="SemiBold"
            Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}" />
        <TextBlock
            Margin="0,6,0,0"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
            Text="{Binding Description, RelativeSource={RelativeSource AncestorType=UserControl}}"
            TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
