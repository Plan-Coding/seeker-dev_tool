<UserControl
    x:Class="Seeker.DevToolbox.Tools.Design.ColorToolView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Seeker.DevToolbox.UI.Controls;assembly=Seeker.DevToolbox.UI"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:ToolPageHeader
            Title="颜色转换"
            Description="支持 #RGB、#RRGGBB、rgb(...)、hsl(...),并实时预览颜色。" />

        <StackPanel Grid.Row="1" Margin="0,18,0,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:TextBox
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    PlaceholderText="例如 #3A6EEB / rgb(58, 110, 235) / hsl(225, 82%, 57%)"
                    Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}" />

                <ui:Button
                    Grid.Column="1"
                    Margin="8,0,0,0"
                    Appearance="Primary"
                    Command="{Binding ConvertCommand}"
                    Content="转换" />

                <ui:Button
                    Grid.Column="2"
                    Margin="8,0,0,0"
                    Appearance="Secondary"
                    Command="{Binding CopyHexCommand}"
                    Content="复制 HEX" />
            </Grid>

            <TextBlock
                Margin="2,8,0,0"
                Style="{StaticResource ToolHintText}"
                Text="RGB 分量范围 0–255,HSL 的饱和度和亮度范围 0–100。" />
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                VerticalAlignment="Top"
                Background="{Binding PreviewBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Height="190" />

            <Grid Grid.Column="2" VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="HEX" />
                <ui:TextBox
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="0,4"
                    FontFamily="Cascadia Mono, Consolas"
                    FontSize="13"
                    IsReadOnly="True"
                    Text="{Binding Hex, Mode=OneWay}" />

                <TextBlock
                    Grid.Row="1"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="RGB" />
                <ui:TextBox
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="0,4"
                    FontFamily="Cascadia Mono, Consolas"
                    FontSize="13"
                    IsReadOnly="True"
                    Text="{Binding Rgb, Mode=OneWay}" />

                <TextBlock
                    Grid.Row="2"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="HSL" />
                <ui:TextBox
                    Grid.Row="2"
                    Grid.Column="1"
                    Margin="0,4"
                    FontFamily="Cascadia Mono, Consolas"
                    FontSize="13"
                    IsReadOnly="True"
                    Text="{Binding Hsl, Mode=OneWay}" />

                <TextBlock
                    Grid.Row="3"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="HSV" />
                <ui:TextBox
                    Grid.Row="3"
                    Grid.Column="1"
                    Margin="0,4"
                    FontFamily="Cascadia Mono, Consolas"
                    FontSize="13"
                    IsReadOnly="True"
                    Text="{Binding Hsv, Mode=OneWay}" />
            </Grid>
        </Grid>

        <controls:ToolStatusBar
            Grid.Row="3"
            Margin="2,10,0,0"
            HasError="{Binding HasError}"
            Text="{Binding Status}" />
    </Grid>
</UserControl>
