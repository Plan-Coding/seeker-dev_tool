<UserControl
    x:Class="Seeker.DevToolbox.Tools.Time.UnixTimeToolView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Seeker.DevToolbox.UI.Controls;assembly=Seeker.DevToolbox.UI"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:ToolPageHeader
            Title="时间戳转换"
            Description="支持 10 位秒级、13 位毫秒级时间戳,以及 2026-10-25 12:30:00 / ISO 8601 日期字符串。" />

        <Grid Grid.Row="1" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ui:TextBox
                Grid.Column="0"
                VerticalAlignment="Center"
                PlaceholderText="输入时间戳或日期时间…"
                Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}" />

            <ComboBox
                Grid.Column="1"
                Width="96"
                Margin="8,0,0,0"
                VerticalAlignment="Center"
                ItemsSource="{Binding Units}"
                SelectedIndex="{Binding UnitIndex}" />

            <ui:Button
                Grid.Column="2"
                Margin="8,0,0,0"
                Appearance="Primary"
                Command="{Binding ConvertCommand}"
                Content="转换" />

            <ui:Button
                Grid.Column="3"
                Margin="8,0,0,0"
                Appearance="Secondary"
                Command="{Binding NowCommand}"
                Content="现在" />
        </Grid>

        <Border
            Grid.Row="2"
            Margin="0,18,0,0"
            Style="{StaticResource ToolCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="本地时间" />
                <ui:TextBox
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="0,4"
                    FontFamily="Cascadia Mono, Consolas"
                    FontSize="13"
                    IsReadOnly="True"
                    Text="{Binding LocalTime, Mode=OneWay}" />

                <TextBlock
                    Grid.Row="1"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="UTC 时间" />
                <ui:TextBox
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="0,4"
                    FontFamily="Cascadia Mono, Consolas"
                    FontSize="13"
                    IsReadOnly="True"
                    Text="{Binding UtcTime, Mode=OneWay}" />

                <TextBlock
                    Grid.Row="2"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="ISO 8601" />
                <ui:TextBox
                    Grid.Row="2"
                    Grid.Column="1"
                    Margin="0,4"
                    FontFamily="Cascadia Mono, Consolas"
                    FontSize="13"
                    IsReadOnly="True"
                    Text="{Binding IsoTime, Mode=OneWay}" />

                <TextBlock
                    Grid.Row="3"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="秒级时间戳" />
                <ui:TextBox
                    Grid.Row="3"
                    Grid.Column="1"
                    Margin="0,4"
                    FontFamily="Cascadia Mono, Consolas"
                    FontSize="13"
                    IsReadOnly="True"
                    Text="{Binding Seconds, Mode=OneWay}" />

                <TextBlock
                    Grid.Row="4"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="毫秒时间戳" />
                <ui:TextBox
                    Grid.Row="4"
                    Grid.Column="1"
                    Margin="0,4"
                    FontFamily="Cascadia Mono, Consolas"
                    FontSize="13"
                    IsReadOnly="True"
                    Text="{Binding Milliseconds, Mode=OneWay}" />
            </Grid>
        </Border>

        <ui:Button
            Grid.Row="3"
            Margin="0,12,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Appearance="Secondary"
            Command="{Binding CopyAllCommand}"
            Content="复制全部结果" />

        <controls:ToolStatusBar
            Grid.Row="4"
            Margin="2,10,0,0"
            HasError="{Binding HasError}"
            Text="{Binding Status}" />
    </Grid>
</UserControl>
