<UserControl
    x:Class="Seeker.DevToolbox.Tools.TextEncodings.EncodingToolView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Seeker.DevToolbox.UI.Controls;assembly=Seeker.DevToolbox.UI"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:ToolPageHeader
            Title="编码转换"
            Description="按源编码还原字节,再按目标编码解码;支持文本乱码修复与整文件转换。" />

        <WrapPanel Grid.Row="1" Margin="0,18,0,0">
            <ComboBox
                Width="160"
                VerticalAlignment="Center"
                DisplayMemberPath="DisplayName"
                ItemsSource="{Binding Encodings}"
                SelectedIndex="{Binding SourceIndex}" />

            <TextBlock
                Margin="10,0"
                VerticalAlignment="Center"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="→" />

            <ComboBox
                Width="160"
                VerticalAlignment="Center"
                DisplayMemberPath="DisplayName"
                ItemsSource="{Binding Encodings}"
                SelectedIndex="{Binding TargetIndex}" />

            <ui:Button
                Margin="12,0,0,0"
                Appearance="Primary"
                Command="{Binding ConvertCommand}"
                Content="转换" />
            <ui:Button
                Margin="8,0,0,0"
                Appearance="Secondary"
                Command="{Binding SwapCommand}"
                Content="交换" />
            <ui:Button
                Margin="8,0,0,0"
                Appearance="Secondary"
                Command="{Binding LoadSampleCommand}"
                Content="示例" />
            <ui:Button
                Margin="8,0,0,0"
                Appearance="Secondary"
                Command="{Binding ClearCommand}"
                Content="清空" />
            <ui:Button
                Margin="8,0,0,0"
                Appearance="Secondary"
                Command="{Binding CopyCommand}"
                Content="复制结果" />
            <ui:Button
                Margin="8,0,0,0"
                Appearance="Secondary"
                Command="{Binding BatchConvertCommand}"
                Content="批量转换" />
        </WrapPanel>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Margin="0,0,8,0"
                VerticalAlignment="Center"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="文件" />

            <ui:TextBox
                Grid.Column="1"
                VerticalAlignment="Center"
                IsReadOnly="True"
                PlaceholderText="选择文件后可预览并整文件转换…"
                Text="{Binding FilePath, Mode=OneWay}" />

            <ui:Button
                Grid.Column="2"
                Margin="8,0,0,0"
                Appearance="Secondary"
                Command="{Binding ChooseFileCommand}"
                Content="选择文件" />

            <ui:Button
                Grid.Column="3"
                Margin="8,0,0,0"
                Appearance="Secondary"
                Command="{Binding SaveAsCommand}"
                Content="另存为" />

            <CheckBox
                Grid.Column="4"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                Content="写入 BOM"
                IsChecked="{Binding WriteBom}" />
        </Grid>

        <StackPanel Grid.Row="3" Margin="2,8,0,12">
            <TextBlock
                Style="{StaticResource ToolHintText}"
                Text="{Binding FileInfo}" />
            <TextBlock
                Style="{StaticResource ToolHintText}"
                Text="示例:输入「浣犲ソ」,源编码 GBK、目标 UTF-8,可还原为「你好」。" />
        </StackPanel>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource ToolSectionLabel}" Text="输入" />
                <ui:TextBox
                    Grid.Row="1"
                    AcceptsReturn="True"
                    FontFamily="Cascadia Mono, Consolas"
                    FontSize="13"
                    HorizontalScrollBarVisibility="Auto"
                    Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="NoWrap"
                    VerticalScrollBarVisibility="Auto" />
            </Grid>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource ToolSectionLabel}" Text="输出" />
                <ui:TextBox
                    Grid.Row="1"
                    AcceptsReturn="True"
                    FontFamily="Cascadia Mono, Consolas"
                    FontSize="13"
                    HorizontalScrollBarVisibility="Auto"
                    IsReadOnly="True"
                    Text="{Binding Output, Mode=OneWay}"
                    TextWrapping="NoWrap"
                    VerticalScrollBarVisibility="Auto" />
            </Grid>
        </Grid>

        <controls:ToolStatusBar
            Grid.Row="5"
            Margin="2,10,0,0"
            HasError="{Binding HasError}"
            Text="{Binding Status}" />
    </Grid>
</UserControl>
