<UserControl
    x:Class="Seeker.DevToolbox.Tools.SystemTools.PortsToolView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Seeker.DevToolbox.UI.Controls;assembly=Seeker.DevToolbox.UI"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:ToolPageHeader
            Title="端口占用"
            Description="列出本机 TCP 监听端口,并关联 PID 与进程名。数据来自 netstat。" />

        <WrapPanel Grid.Row="1" Margin="0,18,0,14">
            <ui:Button
                Appearance="Primary"
                Command="{Binding RefreshCommand}"
                Content="刷新" />

            <ui:TextBox
                Width="280"
                Margin="8,0,0,0"
                VerticalAlignment="Center"
                PlaceholderText="按端口 / PID / 进程 / 地址过滤…"
                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

            <ui:Button
                Margin="8,0,0,0"
                Appearance="Secondary"
                Command="{Binding CopyCommand}"
                Content="复制列表" />
        </WrapPanel>

        <Grid Grid.Row="2" Margin="10,0,24,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80" />
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock
                FontSize="12"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="端口" />
            <TextBlock
                Grid.Column="1"
                FontSize="12"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="监听地址" />
            <TextBlock
                Grid.Column="2"
                FontSize="12"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="PID" />
            <TextBlock
                Grid.Column="3"
                FontSize="12"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="进程" />
        </Grid>

        <ListView
            Grid.Row="3"
            Background="Transparent"
            BorderThickness="0"
            ItemsSource="{Binding Ports}">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="10,2" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            FontFamily="Cascadia Mono, Consolas"
                            FontSize="12"
                            Text="{Binding Port}" />
                        <TextBlock
                            Grid.Column="1"
                            FontFamily="Cascadia Mono, Consolas"
                            FontSize="12"
                            Text="{Binding LocalAddress}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Grid.Column="2"
                            FontFamily="Cascadia Mono, Consolas"
                            FontSize="12"
                            Text="{Binding Pid}" />
                        <TextBlock
                            Grid.Column="3"
                            FontSize="12"
                            Text="{Binding ProcessName}"
                            TextTrimming="CharacterEllipsis" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <controls:ToolStatusBar
            Grid.Row="4"
            Margin="2,10,0,0"
            HasError="{Binding HasError}"
            Text="{Binding Status}" />
    </Grid>
</UserControl>
