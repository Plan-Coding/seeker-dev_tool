<UserControl
    x:Class="Seeker.DevToolbox.Tools.Xml.XmlToolView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Seeker.DevToolbox.UI.Controls;assembly=Seeker.DevToolbox.UI"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <UserControl.InputBindings>
        <KeyBinding
            Key="Enter"
            Command="{Binding FormatCommand}"
            Modifiers="Control" />
    </UserControl.InputBindings>

    <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:ToolPageHeader
            Title="XML 格式化"
            Description="格式化、压缩并校验 XML;保留 XML 声明,中文内容不转义。" />

        <StackPanel
            Grid.Row="1"
            Margin="0,18,0,14"
            Orientation="Horizontal">
            <ui:Button
                Appearance="Primary"
                Command="{Binding FormatCommand}"
                Content="格式化"
                ToolTip="Ctrl+Enter" />
            <ui:Button
                Margin="8,0,0,0"
                Appearance="Secondary"
                Command="{Binding MinifyCommand}"
                Content="压缩" />
            <ui:Button
                Margin="8,0,0,0"
                Appearance="Secondary"
                Command="{Binding LoadSampleCommand}"
                Content="示例" />
            <ui:Button
                Margin="8,0,0,0"
                Appearance="Secondary"
                Command="{Binding ClearCommand}"
                Content="清空" />
            <ui:Button
                Margin="8,0,0,0"
                Appearance="Secondary"
                Command="{Binding CopyCommand}"
                Content="复制结果" />
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource ToolSectionLabel}" Text="输入" />
                <controls:CodeEditor
                    Grid.Row="1"
                    HighlightingName=""
                    Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource ToolSectionLabel}" Text="输出" />
                <controls:CodeEditor
                    Grid.Row="1"
                    HighlightingName=""
                    IsReadOnly="True"
                    Text="{Binding Output, Mode=OneWay}" />
            </Grid>
        </Grid>

        <controls:ToolStatusBar
            Grid.Row="3"
            Margin="2,10,0,0"
            HasError="{Binding HasError}"
            Text="{Binding Status}" />
    </Grid>
</UserControl>
