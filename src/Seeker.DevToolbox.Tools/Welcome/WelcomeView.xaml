<UserControl
    x:Class="Seeker.DevToolbox.Tools.Welcome.WelcomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <UserControl.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="18" />
        </Style>

        <Style x:Key="CardLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <Style x:Key="CardValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>

        <Style x:Key="BulletText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel
            MaxWidth="920"
            Margin="32,28,32,36"
            HorizontalAlignment="Left">

            <!--  Header  -->
            <StackPanel Orientation="Horizontal">
                <Border
                    Width="52"
                    Height="52"
                    Background="{DynamicResource AccentFillColorDefaultBrush}"
                    CornerRadius="14">
                    <ui:SymbolIcon
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="26"
                        Foreground="White"
                        Symbol="Wrench24" />
                </Border>

                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock
                        FontSize="28"
                        FontWeight="SemiBold"
                        Text="Seeker DevToolbox" />
                    <TextBlock
                        Margin="0,4,0,0"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Windows 开发者工具箱 · 免安装 · 离线可用" />
                </StackPanel>
            </StackPanel>

            <!--  Status cards  -->
            <UniformGrid Margin="0,28,0,0" Columns="3">
                <Border
                    Margin="0,0,8,0"
                    Style="{StaticResource Card}">
                    <StackPanel>
                        <ui:SymbolIcon
                            FontSize="20"
                            Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                            Symbol="Desktop24" />
                        <TextBlock
                            Margin="0,12,0,0"
                            Style="{StaticResource CardLabel}"
                            Text="运行模式" />
                        <TextBlock Style="{StaticResource CardValue}" Text="{Binding Mode}" />
                        <TextBlock
                            Margin="0,6,0,0"
                            FontSize="12"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{Binding ModeHint}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border
                    Margin="4,0"
                    Style="{StaticResource Card}">
                    <StackPanel>
                        <ui:SymbolIcon
                            FontSize="20"
                            Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                            Symbol="CodeBlock24" />
                        <TextBlock
                            Margin="0,12,0,0"
                            Style="{StaticResource CardLabel}"
                            Text="已注册工具" />
                        <TextBlock Style="{StaticResource CardValue}">
                            <Run Text="{Binding ToolCount, Mode=OneWay}" />
                            <Run Text="个" />
                        </TextBlock>
                        <TextBlock
                            Margin="0,6,0,0"
                            FontSize="12"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="视图按需创建并缓存"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border
                    Margin="8,0,0,0"
                    Style="{StaticResource Card}">
                    <StackPanel>
                        <ui:SymbolIcon
                            FontSize="20"
                            Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                            Symbol="Info24" />
                        <TextBlock
                            Margin="0,12,0,0"
                            Style="{StaticResource CardLabel}"
                            Text="当前版本" />
                        <TextBlock Style="{StaticResource CardValue}" Text="{Binding Version}" />
                        <TextBlock
                            Margin="0,6,0,0"
                            FontSize="12"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="M5 系统工具"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!--  Data directory  -->
            <Border Margin="0,12,0,0" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock
                        FontSize="15"
                        FontWeight="SemiBold"
                        Text="数据目录" />
                    <TextBlock
                        Margin="0,8,0,0"
                        FontFamily="Cascadia Mono, Consolas"
                        FontSize="13"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{Binding DataRoot}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Margin="0,8,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        Text="设置、日志、缓存全部保存在这里,不写注册表;删除目录即完成卸载。"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!--  Ready checklist  -->
            <Border Margin="0,12,0,0" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock
                        FontSize="15"
                        FontWeight="SemiBold"
                        Text="已就绪" />

                    <TextBlock Style="{StaticResource BulletText}" Text="· 深色 / 浅色 / 跟随系统三种主题,支持 Win11 Mica 背景" />
                    <TextBlock Style="{StaticResource BulletText}" Text="· 设置与最近使用自动保存到 data/settings.json" />
                    <TextBlock Style="{StaticResource BulletText}" Text="· 单实例运行,重复启动会唤起当前窗口" />
                    <TextBlock Style="{StaticResource BulletText}" Text="· 工具模块与 UI 解耦,新增工具只需实现 IToolModule 并注册" />
                    <TextBlock Style="{StaticResource BulletText}" Text="· 全局异常写入 data/logs,崩溃可追溯" />
                </StackPanel>
            </Border>

            <TextBlock
                Margin="2,20,0,0"
                FontSize="12"
                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                Text="提示:在左侧搜索框输入工具名或关键词回车直达;Ctrl+K 可快速聚焦搜索框。" />
        </StackPanel>
    </ScrollViewer>
</UserControl>



