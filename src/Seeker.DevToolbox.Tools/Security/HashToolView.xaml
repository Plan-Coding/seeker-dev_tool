<UserControl
    x:Class="Seeker.DevToolbox.Tools.Security.HashToolView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Seeker.DevToolbox.UI.Controls;assembly=Seeker.DevToolbox.UI"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:ToolPageHeader
            Title="哈希计算"
            Description="按 UTF-8 编码计算摘要;填写 HMAC 密钥后切换为 HMAC 模式。" />

        <StackPanel
            Grid.Row="1"
            Margin="0,18,0,14"
            Orientation="Horizontal">
            <ComboBox
                Width="120"
                VerticalAlignment="Center"
                ItemsSource="{Binding Algorithms}"
                SelectedIndex="{Binding AlgorithmIndex}" />
            <ui:Button
                Margin="8,0,0,0"
                Appearance="Primary"
                Command="{Binding ComputeCommand}"
                Content="计算" />
            <TextBlock
                Margin="16,0,8,0"
                VerticalAlignment="Center"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="HMAC 密钥" />
            <ui:TextBox
                Width="220"
                VerticalAlignment="Center"
                PlaceholderText="可选"
                Text="{Binding HmacKey, UpdateSourceTrigger=PropertyChanged}" />
            <ui:Button
                Margin="8,0,0,0"
                Appearance="Secondary"
                Command="{Binding ClearCommand}"
                Content="清空" />
            <ui:Button
                Margin="8,0,0,0"
                Appearance="Secondary"
                Command="{Binding CopyCommand}"
                Content="复制结果" />
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Margin="0,0,8,0"
                VerticalAlignment="Center"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="文件" />

            <ui:TextBox
                Grid.Column="1"
                VerticalAlignment="Center"
                IsReadOnly="True"
                PlaceholderText="选择任意文件计算哈希…"
                Text="{Binding FilePath, Mode=OneWay}" />

            <ui:Button
                Grid.Column="2"
                Margin="8,0,0,0"
                Appearance="Secondary"
                Command="{Binding ChooseFileCommand}"
                Content="选择文件" />

            <ui:Button
                Grid.Column="3"
                Margin="8,0,0,0"
                Appearance="Secondary"
                Command="{Binding ComputeFileCommand}"
                Content="计算文件哈希" />
        </Grid>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource ToolSectionLabel}" Text="输入" />
                <ui:TextBox
                    Grid.Row="1"
                    AcceptsReturn="True"
                    FontFamily="Cascadia Mono, Consolas"
                    FontSize="13"
                    HorizontalScrollBarVisibility="Auto"
                    PlaceholderText="输入要计算哈希的文本…"
                    Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="NoWrap"
                    VerticalScrollBarVisibility="Auto" />
            </Grid>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource ToolSectionLabel}" Text="结果(小写十六进制)" />
                <ui:TextBox
                    Grid.Row="1"
                    AcceptsReturn="True"
                    FontFamily="Cascadia Mono, Consolas"
                    FontSize="13"
                    HorizontalScrollBarVisibility="Auto"
                    IsReadOnly="True"
                    Text="{Binding Output, Mode=OneWay}"
                    TextWrapping="Wrap"
                    VerticalScrollBarVisibility="Auto" />
            </Grid>
        </Grid>

        <controls:ToolStatusBar
            Grid.Row="4"
            Margin="2,10,0,0"
            HasError="{Binding HasError}"
            Text="{Binding Status}" />
    </Grid>
</UserControl>
