<UserControl
    x:Class="Seeker.DevToolbox.Tools.Generators.IdToolView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Seeker.DevToolbox.UI.Controls;assembly=Seeker.DevToolbox.UI"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:ToolPageHeader
            Title="UUID 生成"
            Description="UUID v7 按时间递增,适合数据库主键;单次最多生成 1000 个。" />

        <StackPanel Grid.Row="1" Margin="0,18,0,14">
            <WrapPanel>
                <ComboBox
                    Width="160"
                    VerticalAlignment="Center"
                    ItemsSource="{Binding Versions}"
                    SelectedIndex="{Binding VersionIndex}" />

                <TextBlock
                    Margin="16,0,8,0"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="数量" />
                <ui:TextBox
                    Width="80"
                    VerticalAlignment="Center"
                    Text="{Binding CountText, UpdateSourceTrigger=PropertyChanged}" />

                <CheckBox
                    Margin="16,0,0,0"
                    VerticalAlignment="Center"
                    Content="大写"
                    IsChecked="{Binding Uppercase}" />
                <CheckBox
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    Content="包含连字符"
                    IsChecked="{Binding IncludeHyphens}" />
            </WrapPanel>

            <WrapPanel Margin="0,10,0,0">
                <ui:Button
                    Appearance="Primary"
                    Command="{Binding GenerateCommand}"
                    Content="生成" />
                <ui:Button
                    Margin="8,0,0,0"
                    Appearance="Secondary"
                    Command="{Binding ClearCommand}"
                    Content="清空" />
                <ui:Button
                    Margin="8,0,0,0"
                    Appearance="Secondary"
                    Command="{Binding CopyCommand}"
                    Content="复制结果" />
            </WrapPanel>
        </StackPanel>

        <ui:TextBox
            Grid.Row="2"
            AcceptsReturn="True"
            FontFamily="Cascadia Mono, Consolas"
            FontSize="13"
            HorizontalScrollBarVisibility="Auto"
            IsReadOnly="True"
            Text="{Binding Output, Mode=OneWay}"
            TextWrapping="NoWrap"
            VerticalScrollBarVisibility="Auto" />

        <controls:ToolStatusBar
            Grid.Row="3"
            Margin="2,10,0,0"
            HasError="{Binding HasError}"
            Text="{Binding Status}" />
    </Grid>
</UserControl>
